# PostgreSQL local (valores de desarrollo, no reutilizar en produccion)
POSTGRES_DB=proyectoxyz
POSTGRES_USER=proyectoxyz_migrator
POSTGRES_PASSWORD=local_migrator_password
APP_DATABASE_USER=proyectoxyz_app
APP_DATABASE_PASSWORD=local_app_password
WORKER_DATABASE_USER=proyectoxyz_worker
WORKER_DATABASE_PASSWORD=local_worker_password
POSTGRES_PORT=55432
DIRECT_DATABASE_URL=postgresql://proyectoxyz_migrator:local_migrator_password@localhost:55432/proyectoxyz
DATABASE_URL=postgresql://proyectoxyz_app:local_app_password@localhost:55432/proyectoxyz
WORKER_DATABASE_URL=postgresql://proyectoxyz_worker:local_worker_password@localhost:55432/proyectoxyz

# SeaweedFS S3 local
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=proyectoxyz-private
S3_ACCESS_KEY_ID=local_s3_access_key
S3_SECRET_ACCESS_KEY=local_s3_secret_key
S3_FORCE_PATH_STYLE=true

# ClamAV local
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Aplicacion
APP_PORT=3000
LOG_LEVEL=info

# Mailrelay SMTP (copiar los valores mostrados por el panel; no colocar secretos reales aqui)
SMTP_HOST=replace_with_mailrelay_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace_with_mailrelay_smtp_user
SMTP_PASSWORD=replace_with_mailrelay_smtp_password
MAIL_FROM_ADDRESS=acceso@dominio-configurado.com
MAIL_FROM_NAME=proyectoxyz
MAIL_REPLY_TO=soporte@dominio-configurado.com

# Better Auth (generar secretos distintos para desarrollo, staging y produccion)
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
