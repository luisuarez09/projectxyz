# syntax=docker/dockerfile:1.7

FROM node:24.15.0-bookworm-slim AS base

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

LABEL org.opencontainers.image.source="https://github.com/luisuarez09/projectxyz"

RUN apt-get update \
  && apt-get install --yes --no-install-recommends \
       ca-certificates \
       openssl \
  && rm -rf /var/lib/apt/lists/*


FROM base AS dependencies

COPY package.json package-lock.json ./

RUN npm ci


FROM dependencies AS source

COPY . .

RUN mkdir -p public \
  && npm run db:generate


FROM source AS builder

ARG NEXT_PUBLIC_APP_URL

ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

RUN test -n "$NEXT_PUBLIC_APP_URL" \
  && BETTER_AUTH_URL="$NEXT_PUBLIC_APP_URL" \
     BETTER_AUTH_TRUSTED_ORIGINS="$NEXT_PUBLIC_APP_URL" \
     BETTER_AUTH_SECRET="build-only-secret-not-used-at-runtime-0123456789abcdef0123456789abcdef" \
     DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build" \
     DIRECT_DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build" \
     WORKER_DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build" \
     S3_ENDPOINT="http://127.0.0.1:8333" \
     S3_REGION="us-east-1" \
     S3_BUCKET="build-only" \
     S3_ACCESS_KEY_ID="build-only" \
     S3_SECRET_ACCESS_KEY="build-only" \
     S3_FORCE_PATH_STYLE="true" \
     CLAMAV_HOST="127.0.0.1" \
     CLAMAV_PORT="3310" \
     CREDENTIAL_ENCRYPTION_ACTIVE_KEY="v1" \
     CREDENTIAL_ENCRYPTION_KEY_V1="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" \
     SMTP_HOST="disabled.invalid" \
     SMTP_PORT="587" \
     SMTP_SECURE="false" \
     SMTP_REQUIRE_TLS="true" \
     SMTP_USER="disabled" \
     SMTP_PASSWORD="disabled" \
     MAIL_FROM_ADDRESS="no-reply@example.invalid" \
     MAIL_FROM_NAME="ProjectXYZ Build" \
     MAIL_REPLY_TO="no-reply@example.invalid" \
     LOG_LEVEL="info" \
     npm run build


FROM base AS web

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NODE_EXTRA_CA_CERTS=/app/certs/sectigo-public-server-authentication-ca-dv-r36.pem

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/certs ./certs

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]


FROM source AS worker

ENV NODE_ENV=production
ENV NODE_EXTRA_CA_CERTS=/app/certs/sectigo-public-server-authentication-ca-dv-r36.pem

CMD ["npm", "run", "worker"]


FROM source AS migrate

ENV NODE_ENV=production

CMD ["npm", "run", "db:deploy"]
