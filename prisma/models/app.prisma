  chartAccounts               CompanyChartAccount[]
  accountingAssignments       CompanyAccountingAssignment[]
  commercialSettings          CompanyCommercialSettings?
  commercialCounterparties    CommercialCounterparty[]
  commercialPartyRoles        CommercialPartyRole[]
  commercialDocuments         CommercialDocument[]
  ivaDeclarations             IvaDeclaration[]
  ivaFiscalBooks              IvaFiscalBook[]
