  firmId                      String                     @map("firm_id") @db.Uuid
  legalName                   String                     @map("legal_name")
  tradeName                   String?                    @map("trade_name")
  rif                         String
  normalizedRif               String                     @map("normalized_rif")
  activity                    String?
  taxpayerType                String?                    @map("taxpayer_type")
  fiscalAddress               String?                    @map("fiscal_address")
  contactName                 String?                    @map("contact_name")
  contactEmail                String?                    @map("contact_email")
  contactPhone                String?                    @map("contact_phone")
  responsibleProfileId        String?                    @map("responsible_profile_id") @db.Uuid
  servicePlan                 String?                    @map("service_plan")
  ivssEmployerNumber          String?                    @map("ivss_employer_number")
  faovPayrollNumber           String?                    @map("faov_payroll_number")
  incorporationDate           DateTime?                  @map("incorporation_date") @db.Date
  commercialRegistry          String?                    @map("commercial_registry")
  registryFolio               String?                    @map("registry_folio")
  registryDocument            String?                    @map("registry_document")
  shareCapital                String?                    @map("share_capital")
  incesRncp                   String?                    @map("inces_rncp")
  legalRepresentativeName     String?                    @map("legal_representative_name")
  legalRepresentativeDocument String?                    @map("legal_representative_document")
  legalRepresentativePhone    String?                    @map("legal_representative_phone")
  legalRepresentativeEmail    String?                    @map("legal_representative_email")
  clientPortalEnabled         Boolean                    @default(false) @map("client_portal_enabled")
  restrictedTaxAccessEnabled  Boolean                    @default(false) @map("restricted_tax_access_enabled")
  status                      CompanyStatus              @default(ACTIVE)
  archivedAt                  DateTime?                  @map("archived_at") @db.Timestamptz(6)
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                     Int                        @default(1)
  firm                        Firm                       @relation(fields: [firmId], references: [id], onDelete: Restrict)
  responsibleProfile          UserProfile?               @relation("CompanyResponsible", fields: [responsibleProfileId], references: [id], onDelete: SetNull)
  activeForProfiles           UserProfile[]              @relation("ActiveCompany")
  clients                     FirmClientCompany[]
  branches                    Branch[]
  roleAssignments             RoleAssignment[]
  invitations                 Invitation[]
  invitationAccess            InvitationCompanyAccess[]
  storedObjects               StoredObject[]
  documents                   Document[]
  officers                    CompanyOfficer[]
  offerings                   CompanyOffering[]
  municipalActivities         CompanyMunicipalActivity[]
  complianceCases             ComplianceCase[]
