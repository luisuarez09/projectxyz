/// Tenant anchor retained even while the product launches with one firm.
model Firm {
  id                       String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityType               FirmEntityType           @default(LEGAL_ENTITY) @map("entity_type")
  legalName                String                   @map("legal_name")
  tradeName                String?                  @map("trade_name")
  rif                      String?                  @unique
  email                    String?
  phone                    String?
  fiscalAddress            String?                  @map("fiscal_address")
  pdfHeader                String?                  @map("pdf_header")
  pdfFooter                String?                  @map("pdf_footer")
  archivePaperSize         String                   @default("LETTER") @map("archive_paper_size")
  exchangeRateSyncStart    String                   @default("18:00") @map("exchange_rate_sync_start")
  exchangeRateSyncEnd      String                   @default("21:00") @map("exchange_rate_sync_end")
  exchangeRateSyncInterval Int                      @default(30) @map("exchange_rate_sync_interval")
  logoStoredObjectId       String?                  @unique @map("logo_stored_object_id") @db.Uuid
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                  Int                      @default(1)
  profiles                 UserProfile[]
  clients                  FirmClient[]
  companies                Company[]
  roles                    Role[]
  assignments              RoleAssignment[]
  invitations              Invitation[]
  storedObjects            StoredObject[]
  documents                Document[]
  mailSettings             FirmMailSettings?
  offerings                FirmOffering[]
  taxRates                 TaxRate[]
  fiscalCalendars          FiscalCalendar[]
  complianceCases          ComplianceCase[]
  complianceEvidence       ComplianceCaseEvidence[]
  exchangeRates            ExchangeRate[]
  exchangeRateSyncRuns     ExchangeRateSyncRun[]
  currencies               FirmCurrency[]
  chartTemplate            FirmChartTemplate?
  chartAccounts            CompanyChartAccount[]
  accountingAssignments    CompanyAccountingAssignment[]
  commercialSettings       CompanyCommercialSettings[]
  commercialCounterparties CommercialCounterparty[]
  commercialPartyRoles     CommercialPartyRole[]
  commercialDocuments      CommercialDocument[]
  ivaDeclarations          IvaDeclaration[]
  ivaFiscalBooks           IvaFiscalBook[]
  logoStoredObject         StoredObject?            @relation("FirmLogo", fields: [logoStoredObjectId], references: [id], onDelete: Restrict)

  @@map("firms")
  @@schema("app")
}

model FirmMailSettings {
  id                     String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId                 String               @unique @map("firm_id") @db.Uuid
  enabled                Boolean              @default(false)
  provider               MailProvider         @default(MAILRELAY)
  senderDomain           String?              @map("sender_domain")
  smtpHost               String?              @map("smtp_host")
  smtpPort               Int                  @default(587) @map("smtp_port")
  smtpSecure             Boolean              @default(false) @map("smtp_secure")
  smtpRequireTls         Boolean              @default(true) @map("smtp_require_tls")
  smtpUser               String?              @map("smtp_user")
  smtpPasswordCiphertext Bytes?               @map("smtp_password_ciphertext")
  smtpPasswordIv         Bytes?               @map("smtp_password_iv")
  smtpPasswordAuthTag    Bytes?               @map("smtp_password_auth_tag")
  smtpPasswordKeyVersion String?              @map("smtp_password_key_version")
  fromAddress            String?              @map("from_address")
  fromName               String               @default("proyectoxyz") @map("from_name")
  replyTo                String?              @map("reply_to")
  connectionStatus       MailConnectionStatus @default(NOT_TESTED) @map("connection_status")
  lastVerifiedAt         DateTime?            @map("last_verified_at") @db.Timestamptz(6)
  lastConnectionError    String?              @map("last_connection_error")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                Int                  @default(1)
  firm                   Firm                 @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@map("firm_mail_settings")
  @@schema("app")
}

model FirmOffering {
  id                   String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId               String                          @map("firm_id") @db.Uuid
  key                  String
  kind                 CompanyOfferingKind
  taxpayerCondition    FiscalCalendarTaxpayerCondition @default(ALL) @map("taxpayer_condition")
  name                 String
  organism             String
  frequency            String
  speFrequency         String?                         @map("spe_frequency")
  deadlineMode         String                          @map("deadline_mode")
  deadlineDayCount     Int                             @default(0) @map("deadline_day_count")
  deadlineDayType      String                          @map("deadline_day_type")
  deadlineBase         String                          @map("deadline_base")
  evidenceRequirements Json                            @default("[]") @map("evidence_requirements") @db.JsonB
  templateKey          String?                         @map("template_key")
  source               String?
  effectiveFrom        DateTime?                       @map("effective_from") @db.Date
  effectiveTo          DateTime?                       @map("effective_to") @db.Date
  active               Boolean                         @default(false)
  archiveOrder         Int                             @default(1000) @map("archive_order")
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int                             @default(1)
  firm                 Firm                            @relation(fields: [firmId], references: [id], onDelete: Restrict)
  taxRates             TaxRate[]
  calendarMatrixLinks  FiscalCalendarMatrixOffering[]
  complianceCases      ComplianceCase[]

  @@unique([firmId, key])
  @@index([firmId, kind, active])
  @@map("firm_offerings")
  @@schema("app")
}

model TaxRate {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId        String       @map("firm_id") @db.Uuid
  offeringId    String       @map("offering_id") @db.Uuid
  name          String
  rate          Decimal      @db.Decimal(8, 4)
  effectiveFrom DateTime?    @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  source        String?
  active        Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int          @default(1)
  firm          Firm         @relation(fields: [firmId], references: [id], onDelete: Restrict)
  offering      FirmOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  commercialDocuments CommercialDocument[]

  @@index([firmId, offeringId, effectiveFrom])
  @@map("tax_rates")
  @@schema("app")
}

/// Versioned exchange rate. A partial database index guarantees one current
/// value per firm, currency and effective date without deleting prior values.
model ExchangeRate {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId            String                 @map("firm_id") @db.Uuid
  currency          String
  rate              Decimal                @db.Decimal(20, 8)
  effectiveDate     DateTime               @map("effective_date") @db.Date
  sourceKind        ExchangeRateSourceKind @map("source_kind")
  sourceUrl         String?                @map("source_url")
  sourceHash        String?                @map("source_hash")
  sourcePublishedAt DateTime?              @map("source_published_at") @db.Timestamptz(6)
  capturedAt        DateTime               @default(now()) @map("captured_at") @db.Timestamptz(6)
  manualReason      String?                @map("manual_reason")
  recordedByUserId  String?                @map("recorded_by_user_id") @db.Uuid
  supersededAt      DateTime?              @map("superseded_at") @db.Timestamptz(6)
  supersededById    String?                @map("superseded_by_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  firm              Firm                   @relation(fields: [firmId], references: [id], onDelete: Restrict)
  firmCurrency      FirmCurrency           @relation(fields: [firmId, currency], references: [firmId, code], onDelete: Restrict)
  recordedBy        User?                  @relation("ExchangeRateRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  supersededBy      ExchangeRate?          @relation("ExchangeRateSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes        ExchangeRate[]         @relation("ExchangeRateSupersession")

  @@index([firmId, currency, effectiveDate])
  @@index([recordedByUserId])
  @@map("exchange_rates")
  @@schema("app")
}

model FirmCurrency {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId           String             @map("firm_id") @db.Uuid
  code             String
  name             String
  symbol           String?
  source           FirmCurrencySource
  sourceName       String?            @map("source_name")
  sourceUrl        String?            @map("source_url")
  automaticEnabled Boolean            @default(false) @map("automatic_enabled")
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int                @default(1)
  firm             Firm               @relation(fields: [firmId], references: [id], onDelete: Restrict)
  exchangeRates    ExchangeRate[]

  @@unique([firmId, code])
  @@index([firmId, active])
  @@map("firm_currencies")
  @@schema("app")
}

model ExchangeRateSyncRun {
  id                String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId            String                  @map("firm_id") @db.Uuid
  trigger           ExchangeRateSyncTrigger
  status            ExchangeRateSyncStatus
  scheduleKey       String?                 @map("schedule_key")
  effectiveDate     DateTime?               @map("effective_date") @db.Date
  ratesFound        Int                     @default(0) @map("rates_found")
  errorMessage      String?                 @map("error_message")
  initiatedByUserId String?                 @map("initiated_by_user_id") @db.Uuid
  startedAt         DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime                @default(now()) @map("completed_at") @db.Timestamptz(6)
  firm              Firm                    @relation(fields: [firmId], references: [id], onDelete: Restrict)
  initiatedBy       User?                   @relation("ExchangeRateSyncInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@unique([firmId, scheduleKey])
  @@index([firmId, startedAt])
  @@index([initiatedByUserId])
  @@map("exchange_rate_sync_runs")
  @@schema("app")
}

model FiscalCalendar {
  id                String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId            String                          @map("firm_id") @db.Uuid
  key               String
  name              String
  year              Int
  taxpayerCondition FiscalCalendarTaxpayerCondition @map("taxpayer_condition")
  effectiveFrom     DateTime                        @map("effective_from") @db.Date
  effectiveTo       DateTime                        @map("effective_to") @db.Date
  sourceGazette     String?                         @map("source_gazette")
  sourcePublishedAt DateTime?                       @map("source_published_at") @db.Date
  sourceProvision   String?                         @map("source_provision")
  sourceIssuedAt    DateTime?                       @map("source_issued_at") @db.Date
  sourceNote        String?                         @map("source_note")
  active            Boolean                         @default(false)
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int                             @default(1)
  firm              Firm                            @relation(fields: [firmId], references: [id], onDelete: Restrict)
