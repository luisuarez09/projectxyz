  @@unique([firmId, normalizedRif])
  @@index([firmId, status])
  @@index([responsibleProfileId])
  @@map("companies")
  @@schema("app")
}

model CompanyLaborSettings {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId        String   @unique @map("company_id") @db.Uuid

  // Nómina y conversión
  payrollFrequency String   @default("BIWEEKLY") @map("payroll_frequency")   // WEEKLY | BIWEEKLY | MONTHLY
  salaryCurrency   String   @default("USD")       @map("salary_currency")
  rateSource       String   @default("BCV")       @map("rate_source")         // BCV | COMPANY
  rateLockMoment   String   @default("PAYROLL_CREATION") @map("rate_lock_moment") // PAYROLL_CREATION | PAYMENT_DATE | FIRST_PERIOD

  // Salario mínimo de referencia (sin asumir monto)
  minWageAmount    Decimal? @map("min_wage_amount") @db.Decimal(20, 2)
  minWageCurrency  String   @default("VES") @map("min_wage_currency")
  minWageEffectiveFrom DateTime? @map("min_wage_effective_from") @db.Date
  minWageSource    String?  @map("min_wage_source")

  // Vacaciones y utilidades
  benefitScheme    String   @default("LEGAL") @map("benefit_scheme")          // LEGAL | CUSTOM
  vacationSchedule String   @default("ANNIVERSARY") @map("vacation_schedule") // ANNIVERSARY | YEAR_END

  vacationDaysBase      Int  @default(15) @map("vacation_days_base")
  vacationDaysIncrement Int  @default(1)  @map("vacation_days_increment")
  vacationDaysCap       Int  @default(30) @map("vacation_days_cap")
  vacationBasis         String @default("AGREED_SALARY") @map("vacation_basis")

  bonusDaysBase         Int  @default(15) @map("bonus_days_base")
  bonusDaysIncrement    Int  @default(1)  @map("bonus_days_increment")
  bonusDaysCap          Int  @default(30) @map("bonus_days_cap")
  bonusBasis            String @default("PENDING") @map("bonus_basis")

  profitDaysBase        Int  @default(30) @map("profit_days_base")
  profitDaysIncrement   Int  @default(0)  @map("profit_days_increment")
  profitDaysCap         Int  @default(0)  @map("profit_days_cap")
  profitBasis           String @default("PENDING") @map("profit_basis")

  // Bono de alimentación
