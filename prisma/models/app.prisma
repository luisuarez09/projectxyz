enum UserProfileType {
  STAFF
  CLIENT

  @@schema("app")
}

enum FirmClientStatus {
  ACTIVE
  INACTIVE

  @@schema("app")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("app")
}

enum CompanyOfferingKind {
  TAX
  SERVICE

  @@schema("app")
}

enum AssignmentScope {
  FIRM
  COMPANY
  BRANCH

  @@schema("app")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@schema("app")
}

enum StoredObjectStatus {
  PENDING
  QUARANTINED
  AVAILABLE
  REJECTED
  ARCHIVED

  @@schema("app")
}

enum MailProvider {
  MAILRELAY
  CUSTOM_SMTP

  @@schema("app")
}

enum MailConnectionStatus {
  NOT_TESTED
  VERIFIED
  FAILED

  @@schema("app")
}

enum FirmEntityType {
  NATURAL_PERSON
  LEGAL_ENTITY

  @@schema("app")
}

enum InvitationDeliveryMethod {
  MANUAL_LINK
  SMTP

  @@schema("app")
}

enum FiscalCalendarTaxpayerCondition {
  SPECIAL_TAXPAYER
  ORDINARY
  ALL

  @@schema("app")
}

enum ComplianceCaseStatus {
  PENDING
  PREPARING
  READY_FOR_REVIEW
  SUBMITTED
  PAID
  CLOSED
  INCIDENT
  NOT_APPLICABLE

  @@schema("app")
}

enum ComplianceActivityMode {
  WITH_ACTIVITY
  WITHOUT_ACTIVITY

  @@schema("app")
}

enum ComplianceEvidenceKind {
  SOLVENCY
  DECLARATION_RECEIPT
  DECLARATION_FILE
  PAYMENT_FORM
  PAYMENT_RECEIPT
  INVOICE
  OTHER

  @@schema("app")
}

/// Tenant anchor retained even while the product launches with one firm.
model Firm {
  id                 String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityType         FirmEntityType           @default(LEGAL_ENTITY) @map("entity_type")
  legalName          String                   @map("legal_name")
  tradeName          String?                  @map("trade_name")
  rif                String?                  @unique
  email              String?
  phone              String?
  fiscalAddress      String?                  @map("fiscal_address")
  pdfHeader          String?                  @map("pdf_header")
  pdfFooter          String?                  @map("pdf_footer")
  logoStoredObjectId String?                  @unique @map("logo_stored_object_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                      @default(1)
  profiles           UserProfile[]
  clients            FirmClient[]
  companies          Company[]
  roles              Role[]
  assignments        RoleAssignment[]
  invitations        Invitation[]
  storedObjects      StoredObject[]
  documents          Document[]
  mailSettings       FirmMailSettings?
  offerings          FirmOffering[]
  taxRates           TaxRate[]
  fiscalCalendars    FiscalCalendar[]
  complianceCases    ComplianceCase[]
  complianceEvidence ComplianceCaseEvidence[]
  logoStoredObject   StoredObject?            @relation("FirmLogo", fields: [logoStoredObjectId], references: [id], onDelete: Restrict)

  @@map("firms")
  @@schema("app")
}

model FirmMailSettings {
  id                     String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId                 String               @unique @map("firm_id") @db.Uuid
  enabled                Boolean              @default(false)
  provider               MailProvider         @default(MAILRELAY)
  senderDomain           String?              @map("sender_domain")
  smtpHost               String?              @map("smtp_host")
  smtpPort               Int                  @default(587) @map("smtp_port")
  smtpSecure             Boolean              @default(false) @map("smtp_secure")
  smtpRequireTls         Boolean              @default(true) @map("smtp_require_tls")
  smtpUser               String?              @map("smtp_user")
  smtpPasswordCiphertext Bytes?               @map("smtp_password_ciphertext")
  smtpPasswordIv         Bytes?               @map("smtp_password_iv")
  smtpPasswordAuthTag    Bytes?               @map("smtp_password_auth_tag")
  smtpPasswordKeyVersion String?              @map("smtp_password_key_version")
  fromAddress            String?              @map("from_address")
  fromName               String               @default("proyectoxyz") @map("from_name")
  replyTo                String?              @map("reply_to")
  connectionStatus       MailConnectionStatus @default(NOT_TESTED) @map("connection_status")
  lastVerifiedAt         DateTime?            @map("last_verified_at") @db.Timestamptz(6)
  lastConnectionError    String?              @map("last_connection_error")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                Int                  @default(1)
  firm                   Firm                 @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@map("firm_mail_settings")
  @@schema("app")
}

model FirmOffering {
  id                  String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId              String                          @map("firm_id") @db.Uuid
  key                 String
  kind                CompanyOfferingKind
  taxpayerCondition   FiscalCalendarTaxpayerCondition @default(ALL) @map("taxpayer_condition")
  name                String
  organism            String
  frequency           String
  speFrequency        String?                         @map("spe_frequency")
  deadlineMode        String                          @map("deadline_mode")
  deadlineDayCount    Int                             @default(0) @map("deadline_day_count")
  deadlineDayType     String                          @map("deadline_day_type")
  deadlineBase        String                          @map("deadline_base")
  evidenceRequirements Json                           @default("[]") @map("evidence_requirements") @db.JsonB
  templateKey         String?                         @map("template_key")
  source              String?
  effectiveFrom       DateTime?                       @map("effective_from") @db.Date
  effectiveTo         DateTime?                       @map("effective_to") @db.Date
  active              Boolean                         @default(false)
  createdAt           DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version             Int                             @default(1)
  firm                Firm                            @relation(fields: [firmId], references: [id], onDelete: Restrict)
  taxRates            TaxRate[]
  calendarMatrixLinks FiscalCalendarMatrixOffering[]
  complianceCases     ComplianceCase[]

  @@unique([firmId, key])
  @@index([firmId, kind, active])
  @@map("firm_offerings")
  @@schema("app")
}

model TaxRate {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId        String       @map("firm_id") @db.Uuid
  offeringId    String       @map("offering_id") @db.Uuid
  name          String
  rate          Decimal      @db.Decimal(8, 4)
  effectiveFrom DateTime?    @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  source        String?
  active        Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int          @default(1)
  firm          Firm         @relation(fields: [firmId], references: [id], onDelete: Restrict)
  offering      FirmOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@index([firmId, offeringId, effectiveFrom])
  @@map("tax_rates")
  @@schema("app")
}

model FiscalCalendar {
  id                String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId            String                          @map("firm_id") @db.Uuid
  key               String
  name              String
  year              Int
  taxpayerCondition FiscalCalendarTaxpayerCondition @map("taxpayer_condition")
  effectiveFrom     DateTime                        @map("effective_from") @db.Date
  effectiveTo       DateTime                        @map("effective_to") @db.Date
  sourceGazette     String?                         @map("source_gazette")
  sourcePublishedAt DateTime?                       @map("source_published_at") @db.Date
  sourceProvision   String?                         @map("source_provision")
  sourceIssuedAt    DateTime?                       @map("source_issued_at") @db.Date
  sourceNote        String?                         @map("source_note")
  active            Boolean                         @default(false)
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int                             @default(1)
  firm              Firm                            @relation(fields: [firmId], references: [id], onDelete: Restrict)
  matrices          FiscalCalendarMatrix[]

  @@unique([firmId, key])
  @@index([firmId, taxpayerCondition, effectiveFrom, effectiveTo])
  @@map("fiscal_calendars")
  @@schema("app")
}

model FiscalCalendarMatrix {
  id            String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  calendarId    String                         @map("calendar_id") @db.Uuid
  key           String
  groupKey      String                         @map("group_key")
  label         String
  shortLabel    String                         @map("short_label")
  cadence       String
  periodLabel   String                         @map("period_label")
  note          String?
  ordinal       Int                            @default(0)
  createdAt     DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  calendar      FiscalCalendar                 @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  offeringLinks FiscalCalendarMatrixOffering[]
  dates         FiscalCalendarDate[]

  @@unique([calendarId, key])
  @@index([calendarId, groupKey, ordinal])
  @@map("fiscal_calendar_matrices")
  @@schema("app")
}

model FiscalCalendarMatrixOffering {
  matrixId   String               @map("matrix_id") @db.Uuid
  offeringId String               @map("offering_id") @db.Uuid
  matrix     FiscalCalendarMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  offering   FirmOffering         @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@id([matrixId, offeringId])
  @@index([offeringId])
  @@map("fiscal_calendar_matrix_offerings")
  @@schema("app")
}

model FiscalCalendarDate {
  id           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  matrixId     String               @map("matrix_id") @db.Uuid
  rifCriterion String               @map("rif_criterion")
  periodKey    String               @map("period_key")
  dueDate      DateTime             @map("due_date") @db.Date
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  matrix       FiscalCalendarMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@unique([matrixId, rifCriterion, periodKey])
  @@index([matrixId, dueDate])
  @@map("fiscal_calendar_dates")
  @@schema("app")
}

/// Application-owned data associated with a Better Auth identity.
model UserProfile {
  id                      String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                  String           @unique @map("user_id") @db.Uuid
  firmId                  String           @map("firm_id") @db.Uuid
  displayName             String           @map("display_name")
  profileType             UserProfileType  @default(STAFF) @map("profile_type")
  position                String?
  profession              String?
  active                  Boolean          @default(true)
  retiredAt               DateTime?        @map("retired_at") @db.Timestamptz(6)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 Int              @default(1)
  activeCompanyId         String?          @map("active_company_id") @db.Uuid
  user                    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  firm                    Firm             @relation(fields: [firmId], references: [id], onDelete: Restrict)
  activeCompany           Company?         @relation("ActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  responsibleCompanies    Company[]        @relation("CompanyResponsible")
  assignedComplianceCases ComplianceCase[] @relation("ComplianceCaseAssignee")

  @@index([firmId])
  @@index([activeCompanyId])
  @@map("user_profiles")
  @@schema("app")
}

model FirmClient {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId       String              @map("firm_id") @db.Uuid
  legalName    String              @map("legal_name")
  rif          String?
  contactName  String?             @map("contact_name")
  contactEmail String?             @map("contact_email")
  contactPhone String?             @map("contact_phone")
  status       FirmClientStatus    @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int                 @default(1)
  firm         Firm                @relation(fields: [firmId], references: [id], onDelete: Restrict)
  companies    FirmClientCompany[]

  @@unique([firmId, rif])
  @@index([firmId, status])
  @@map("firm_clients")
  @@schema("app")
}

model Company {
  id                          String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId                      String                     @map("firm_id") @db.Uuid
  legalName                   String                     @map("legal_name")
  tradeName                   String?                    @map("trade_name")
  rif                         String
  normalizedRif               String                     @map("normalized_rif")
  activity                    String?
  taxpayerType                String?                    @map("taxpayer_type")
  fiscalAddress               String?                    @map("fiscal_address")
  contactName                 String?                    @map("contact_name")
  contactEmail                String?                    @map("contact_email")
  contactPhone                String?                    @map("contact_phone")
  responsibleProfileId        String?                    @map("responsible_profile_id") @db.Uuid
  servicePlan                 String?                    @map("service_plan")
  ivssEmployerNumber          String?                    @map("ivss_employer_number")
  faovPayrollNumber           String?                    @map("faov_payroll_number")
  incorporationDate           DateTime?                  @map("incorporation_date") @db.Date
  commercialRegistry          String?                    @map("commercial_registry")
  registryFolio               String?                    @map("registry_folio")
  registryDocument            String?                    @map("registry_document")
  shareCapital                String?                    @map("share_capital")
  incesRncp                   String?                    @map("inces_rncp")
  legalRepresentativeName     String?                    @map("legal_representative_name")
  legalRepresentativeDocument String?                    @map("legal_representative_document")
  legalRepresentativePhone    String?                    @map("legal_representative_phone")
  legalRepresentativeEmail    String?                    @map("legal_representative_email")
  clientPortalEnabled         Boolean                    @default(false) @map("client_portal_enabled")
  restrictedTaxAccessEnabled  Boolean                    @default(false) @map("restricted_tax_access_enabled")
  status                      CompanyStatus              @default(ACTIVE)
  archivedAt                  DateTime?                  @map("archived_at") @db.Timestamptz(6)
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                     Int                        @default(1)
  firm                        Firm                       @relation(fields: [firmId], references: [id], onDelete: Restrict)
  responsibleProfile          UserProfile?               @relation("CompanyResponsible", fields: [responsibleProfileId], references: [id], onDelete: SetNull)
  activeForProfiles           UserProfile[]              @relation("ActiveCompany")
  clients                     FirmClientCompany[]
  branches                    Branch[]
  roleAssignments             RoleAssignment[]
  invitations                 Invitation[]
  invitationAccess            InvitationCompanyAccess[]
  storedObjects               StoredObject[]
  documents                   Document[]
  officers                    CompanyOfficer[]
  offerings                   CompanyOffering[]
  municipalActivities         CompanyMunicipalActivity[]
  complianceCases             ComplianceCase[]
  complianceEvidence          ComplianceCaseEvidence[]

  @@unique([firmId, normalizedRif])
  @@index([firmId, status])
  @@index([responsibleProfileId])
  @@map("companies")
  @@schema("app")
}

model CompanyOfficer {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  position     String
  fullName     String    @map("full_name")
  termStartsAt DateTime? @map("term_starts_at") @db.Date
  termEndsAt   DateTime? @map("term_ends_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_officers")
  @@schema("app")
}

model CompanyOffering {
  companyId   String              @map("company_id") @db.Uuid
  kind        CompanyOfferingKind
  offeringKey String              @map("offering_key")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, kind, offeringKey])
  @@index([companyId, kind])
  @@map("company_offerings")
  @@schema("app")
}

model ComplianceCase {
  id                String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId            String                   @map("firm_id") @db.Uuid
  companyId         String                   @map("company_id") @db.Uuid
  offeringId        String                   @map("offering_id") @db.Uuid
  assignedProfileId String?                  @map("assigned_profile_id") @db.Uuid
  periodKey         String                   @map("period_key")
  periodLabel       String                   @map("period_label")
  periodMonth       DateTime                 @map("period_month") @db.Date
  periodStart       DateTime                 @map("period_start") @db.Date
  periodEnd         DateTime                 @map("period_end") @db.Date
  dueDate           DateTime?                @map("due_date") @db.Date
  status            ComplianceCaseStatus     @default(PENDING)
  activityMode      ComplianceActivityMode?  @map("activity_mode")
  filedAt           DateTime?                @map("filed_at") @db.Date
  paidAt            DateTime?                @map("paid_at") @db.Date
  amount            Decimal?                 @db.Decimal(20, 6)
  offeringName      String                   @map("offering_name")
  offeringKind      CompanyOfferingKind      @map("offering_kind")
  organism          String
  cadence           String
  regime            String
  deadlineBasis     String                   @map("deadline_basis")
  ruleVersion       Int                      @map("rule_version")
  sourceSnapshot    String?                  @map("source_snapshot")
  evidenceRequirements Json                  @default("[]") @map("evidence_requirements") @db.JsonB
  suppressedAt      DateTime?                @map("suppressed_at") @db.Timestamptz(6)
  suppressionReason String?                  @map("suppression_reason")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int                      @default(1)
  firm              Firm                     @relation(fields: [firmId], references: [id], onDelete: Restrict)
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  offering          FirmOffering             @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  assignedProfile   UserProfile?             @relation("ComplianceCaseAssignee", fields: [assignedProfileId], references: [id], onDelete: SetNull)
  evidences         ComplianceCaseEvidence[]

  @@unique([companyId, offeringId, periodKey])
  @@index([firmId, periodMonth, status])
  @@index([firmId, periodMonth, suppressedAt])
  @@index([companyId, periodMonth, dueDate])
  @@index([assignedProfileId, status])
  @@map("compliance_cases")
  @@schema("app")
}

model ComplianceCaseEvidence {
  id               String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId           String                 @map("firm_id") @db.Uuid
  companyId        String                 @map("company_id") @db.Uuid
  caseId           String                 @map("case_id") @db.Uuid
  storedObjectId   String                 @unique @map("stored_object_id") @db.Uuid
  uploadedByUserId String                 @map("uploaded_by_user_id") @db.Uuid
  kind             ComplianceEvidenceKind
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  case             ComplianceCase         @relation(fields: [caseId], references: [id], onDelete: Restrict)
  firm             Firm                   @relation(fields: [firmId], references: [id], onDelete: Restrict)
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  storedObject     StoredObject           @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  uploadedBy       User                   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([caseId, kind])
  @@index([firmId, companyId, createdAt])
  @@index([uploadedByUserId])
  @@map("compliance_case_evidences")
  @@schema("app")
}

model CompanyMunicipalActivity {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  branchName       String?  @map("branch_name")
  jurisdiction     String
  economicActivity String   @map("economic_activity")
  rate             Decimal  @db.Decimal(10, 4)
  effectiveFrom    DateTime @map("effective_from") @db.Date
  source           String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, effectiveFrom])
  @@map("company_municipal_activities")
  @@schema("app")
}

model FirmClientCompany {
  firmClientId String     @map("firm_client_id") @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  firmClient   FirmClient @relation(fields: [firmClientId], references: [id], onDelete: Restrict)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([firmClientId, companyId])
  @@index([companyId])
  @@map("firm_client_companies")
  @@schema("app")
}

model Branch {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  name            String
  code            String?
  address         String
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int              @default(1)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[]
  invitations     Invitation[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("branches")
  @@schema("app")
}

model Permission {
  key             String           @id
  description     String
  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("app")
}

model Role {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId      String           @map("firm_id") @db.Uuid
  name        String
  slug        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int              @default(1)
  firm        Firm             @relation(fields: [firmId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]
  invitations Invitation[]

  @@unique([firmId, slug])
  @@index([firmId, archivedAt])
  @@map("roles")
  @@schema("app")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
  @@schema("app")
}

model RoleAssignment {
  id         String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId     String          @map("firm_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  roleId     String          @map("role_id") @db.Uuid
  scope      AssignmentScope
  companyId  String?         @map("company_id") @db.Uuid
  branchId   String?         @map("branch_id") @db.Uuid
  validFrom  DateTime        @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime?       @map("valid_until") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  firm       Firm            @relation(fields: [firmId], references: [id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  company    Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scope, companyId, branchId])
  @@index([firmId, userId])
  @@index([companyId])
  @@index([branchId])
  @@map("role_assignments")
  @@schema("app")
}

model Invitation {
  id                 String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId             String                    @map("firm_id") @db.Uuid
  email              String
  name               String
  profileType        UserProfileType           @default(STAFF) @map("profile_type")
  roleId             String                    @map("role_id") @db.Uuid
  scope              AssignmentScope
  companyId          String?                   @map("company_id") @db.Uuid
  branchId           String?                   @map("branch_id") @db.Uuid
  tokenHash          String                    @unique @map("token_hash")
  status             InvitationStatus          @default(PENDING)
  expiresAt          DateTime                  @map("expires_at") @db.Timestamptz(6)
  invitedByUserId    String?                   @map("invited_by_user_id") @db.Uuid
  acceptedByUserId   String?                   @map("accepted_by_user_id") @db.Uuid
  acceptedAt         DateTime?                 @map("accepted_at") @db.Timestamptz(6)
  lastDeliveryMethod InvitationDeliveryMethod? @map("last_delivery_method")
  lastDeliveredAt    DateTime?                 @map("last_delivered_at") @db.Timestamptz(6)
  position           String?
  profession         String?
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  firm               Firm                      @relation(fields: [firmId], references: [id], onDelete: Restrict)
  role               Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  company            Company?                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch             Branch?                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invitedBy          User?                     @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy         User?                     @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  companyAccess      InvitationCompanyAccess[]

  @@index([firmId, email, status])
  @@index([expiresAt, status])
  @@map("invitations")
  @@schema("app")
}

model InvitationCompanyAccess {
  invitationId String     @map("invitation_id") @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([invitationId, companyId])
  @@index([companyId])
  @@map("invitation_company_access")
  @@schema("app")
}

model StoredObject {
  id                 String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId             String                  @map("firm_id") @db.Uuid
  companyId          String?                 @map("company_id") @db.Uuid
  uploadedByUserId   String                  @map("uploaded_by_user_id") @db.Uuid
  bucket             String
  objectKey          String                  @map("object_key")
  originalName       String                  @map("original_name")
  declaredMime       String                  @map("declared_mime")
  detectedMime       String?                 @map("detected_mime")
  sizeBytes          BigInt                  @map("size_bytes")
  checksumSha256     String                  @map("checksum_sha256")
  status             StoredObjectStatus      @default(PENDING)
  rejectionReason    String?                 @map("rejection_reason")
  scannedAt          DateTime?               @map("scanned_at") @db.Timestamptz(6)
  availableAt        DateTime?               @map("available_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  firm               Firm                    @relation(fields: [firmId], references: [id], onDelete: Restrict)
  company            Company?                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy         User                    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  documentVersions   DocumentVersion[]
  firmLogo           Firm?                   @relation("FirmLogo")
  complianceEvidence ComplianceCaseEvidence?

  @@unique([bucket, objectKey])
  @@index([firmId, companyId, status])
  @@index([checksumSha256])
  @@map("stored_objects")
  @@schema("app")
}

model Document {
  id        String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firmId    String            @map("firm_id") @db.Uuid
  companyId String?           @map("company_id") @db.Uuid
  title     String
  category  String
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int               @default(1)
  firm      Firm              @relation(fields: [firmId], references: [id], onDelete: Restrict)
  company   Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  versions  DocumentVersion[]
  links     DocumentLink[]

  @@index([firmId, companyId, category])
  @@map("documents")
  @@schema("app")
}

model DocumentVersion {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId      String       @map("document_id") @db.Uuid
  storedObjectId  String       @unique @map("stored_object_id") @db.Uuid
  versionNumber   Int          @map("version_number")
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  storedObject    StoredObject @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([createdByUserId])
  @@map("document_versions")
  @@schema("app")
}

model DocumentLink {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
  @@schema("app")
}
